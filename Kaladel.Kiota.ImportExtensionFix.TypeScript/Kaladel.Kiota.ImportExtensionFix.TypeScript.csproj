<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>Kaladel.Kiota.ImportExtensionFix.TypeScript</RootNamespace>

        <PackAsTool>true</PackAsTool>
        <ToolCommandName>kiota-importfix-ts</ToolCommandName>
        <PackageId>Kaladel.Kiota.ImportExtensionFix.TypeScript</PackageId>
        <Version>1.0.0</Version>
        <Authors>Kaladel</Authors>
        <Description>
            Post-processes Kiota-generated TypeScript clients to strip the unnecessary ".js"
            extensions (and redundant "/index" segments) that Kiota adds to relative import/export
            specifiers, which can otherwise confuse IDE type resolution for the generated ".ts"
            files.
        </Description>

        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/kaladeluk/kiota</PackageProjectUrl>
        <RepositoryUrl>https://github.com/kaladeluk/kiota</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageTags>kiota;openapi;typescript;codegen;esm;imports</PackageTags>
        <PackageReadmeFile>readme.md</PackageReadmeFile>
        <PackageReleaseNotes>Initial release.</PackageReleaseNotes>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="System.CommandLine" />
        <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
    </ItemGroup>

    <ItemGroup>
        <None Include="readme.md" Pack="true" PackagePath="\" />
    </ItemGroup>

</Project>
