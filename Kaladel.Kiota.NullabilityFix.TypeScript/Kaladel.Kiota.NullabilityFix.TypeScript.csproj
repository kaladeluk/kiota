<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>Kaladel.Kiota.NullabilityFix.TypeScript</RootNamespace>

        <PackAsTool>true</PackAsTool>
        <ToolCommandName>kiota-nullfix-ts</ToolCommandName>
        <PackageId>Kaladel.Kiota.NullabilityFix.TypeScript</PackageId>
        <Version>1.0.0</Version>
        <Authors>Kaladel</Authors>
        <Description>
            Post-processes Kiota-generated TypeScript models so that properties marked as
            "required" (and non-nullable) in the source OpenAPI document are emitted as
            required/non-nullable TypeScript properties, instead of Kiota's default of making
            every property optional and nullable.
        </Description>

        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/kaladeluk/kiota</PackageProjectUrl>
        <RepositoryUrl>https://github.com/kaladeluk/kiota</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageTags>kiota;openapi;typescript;codegen;nullability;required</PackageTags>
        <PackageReadmeFile>readme.md</PackageReadmeFile>
        <PackageReleaseNotes>Initial release.</PackageReleaseNotes>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.OpenApi" />
        <PackageReference Include="System.CommandLine" />
        <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
    </ItemGroup>

    <ItemGroup>
        <None Include="readme.md" Pack="true" PackagePath="\" />
    </ItemGroup>

</Project>
